{
  "name": "kkiniplan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "catalog:collect": "node --env-file=.env.local scripts/expand-diverse-catalog.mjs --resume",
    "catalog:apply": "node --env-file=.env.local scripts/expand-diverse-catalog.mjs --apply",
    "catalog:expand": "node scripts/run-catalog-expansion.mjs",
    "catalog:status": "node --env-file=.env.local scripts/expand-diverse-catalog.mjs --status",
    "foodsafety:import": "node --env-file=.env.local scripts/import-foodsafety-processed.mjs",
    "foodsafety:import-dishes": "node --env-file=.env.local scripts/import-foodsafety-dishes.mjs",
    "foodsafety:import-raw": "node --env-file=.env.local scripts/import-foodsafety-raw.mjs",
    "foodsafety:import-bulk-api": "node --env-file=.env.local scripts/import-foodsafety-bulk-api.mjs",
    "recipes:generate-similar": "node --env-file=.env.local --import tsx scripts/generate-similar-recipes.mjs",
    "recipes:import-images": "node --env-file=.env.local --import tsx scripts/import-recipe-images.mjs",
    "recipes:synthesize-ai-ingredients": "node --env-file=.env.local --import tsx scripts/synthesize-ai-ingredients.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:setup": "node scripts/setup-local-db.mjs && docker compose --env-file .env.local up -d --wait && node scripts/migrate.mjs --local",
    "db:migrate": "node scripts/migrate.mjs",
    "db:down": "docker compose --env-file .env.local down",
    "test:auth": "node scripts/smoke-auth.mjs",
    "test:google": "node --env-file=.env.local --import tsx --test tests/google-auth.test.ts",
    "test:firebase": "node --env-file=.env.local --import tsx --test tests/firebase-auth.test.ts",
    "test:ocr": "node --import tsx --test tests/nutrition-ocr.test.ts",
    "test:meals": "node --env-file=.env.local --import tsx --test tests/body-profile.test.ts tests/meal-plan.test.ts tests/meal-plans-api.test.ts",
    "test:community": "node --env-file=.env.local --import tsx --test tests/community.test.ts",
    "db:catalog": "node --env-file=.env.local scripts/seed-verified-catalog.mjs",
    "test:dashboard": "node --env-file=.env.local --import tsx --test tests/dashboard.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.8",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "google-auth-library": "^11.0.2",
    "next": "16.3.5",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "xlsx": "^0.18.5"
  }
}
