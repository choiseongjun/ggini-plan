# Copy to .env.local and enter server-specific credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full&sslrootcert=certs%2Fsupabase-ca.crt&options=-c+search_path%3Dkkiniplan
# Optional source database for local data migration.
DATABASE_URL_LOCAL=
# Optional Docker local DB password; generated by npm run db:setup if absent.
POSTGRES_PASSWORD=
AUTH_URL=http://localhost:3000
ADMIN_EMAILS=you@example.com

# Server-only OpenAI key: enables GPT nutrition reading for uploads and collection.
OPENAI_API_KEY=
# Optional; defaults to gpt-4.1. Must support image input and structured outputs.
OPENAI_NUTRITION_MODEL=gpt-4.1

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=

# Server only. Never prefix the secret key with NEXT_PUBLIC.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=ggini-plan
# Optional additional trusted image CDN hostnames, comma-separated.
IMAGE_IMPORT_HOSTS=

SITE_URL=https://gginiplan.kr
# Enable only on the public production deployment.
SEO_INDEXING_ENABLED=false
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=

# Server-only YouTube Data API v3 key (public recipe video search)
YOUTUBE_API_KEY=

# Server-only Coupang Partners (affiliate) API keys: enables pulling products via /admin/collect.
# Issue from partners.coupang.com > 오픈 API. No business registration required to sign up.
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# Server-only 식품안전나라 (foodsafetykorea.go.kr) Open API key: nutrition DB matching in /admin/collect.
# Issue from foodsafetykorea.go.kr > 데이터활용서비스 (auto-approved, no business registration needed).
FOODSAFETY_API_KEY=

# data.go.kr general auth key for "식품의약품안전처_식품영양성분DB정보" (service FoodNtrCpntDbInfo03).
# Separate application/key from FOODSAFETY_API_KEY above, even though the underlying data overlaps.
# Used only by scripts/import-foodsafety-bulk-api.mjs (bulk refresh, not called from the app itself).
FOODSAFETY_BULK_API_KEY=

# Kakao Developers REST API key (다음 검색 > 이미지 검색): issue from developers.kakao.com > 내 애플리케이션.
# Used only by scripts/import-recipe-images.mjs to backfill a representative photo per synthetic
# govDB recipe (lib/recipe-optimizer-plan.ts) — these have no real product to photograph otherwise.
# (Naver's equivalent free API stopped issuing new keys 2026-07-31, and Google's Custom Search JSON
# API is closed to new customers entirely, so Kakao is the one of the three still onboarding new users.)
KAKAO_REST_API_KEY=
# 지도 표시: Naver Cloud Maps > Web Dynamic Map Client ID (ncpKeyId).
# 웹 서비스 URL에 운영 도메인, http://localhost:3000, http://127.0.0.1:3000 등록.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# NAVER API HUB Search: server-only credentials, separate from Maps.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
