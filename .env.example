# npm run db:setup generates matching local values in .env and .env.local.
DATABASE_URL=postgresql://kkiniplan:replace-with-local-password@localhost:5432/kkiniplan
ADMIN_EMAILS=you@example.com

# Google Cloud Console > Google Auth Platform > Clients > Web application
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Firebase Google sign-in (used by the login button)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
